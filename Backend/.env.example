# ==============================
# APP CONFIG
# ==============================
NODE_ENV=development
PORT=8080
CLIENT_URL=http://localhost:3000

# ==============================
# RATE LIMIT (THROTTLE)
# ==============================
THROTTLE_TTL_MS=1000
THROTTLE_LIMIT=60

# ==============================
# DATABASE (POSTGRESQL)
# ==============================
DB_HOST=localhost
DB_PORT=5436
DB_USERNAME=postgres
DB_PASSWORD=your_db_password_here
DB_NAME=dacn261
DB_SYNCHRONIZE=true

DB_POOL_MAX=20
DB_POOL_MIN=2
DB_POOL_CONNECTION_TIMEOUT_MS=5000
DB_POOL_IDLE_TIMEOUT_MS=30000

# ==============================
# EMAIL (SMTP) - Dùng gửi mã OTP, thông báo hệ thống
# ==============================
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM=noreply@flatfoot.com

# ==============================
# AUTHENTICATION
# ==============================
BETTER_AUTH_SECRET=your_auth_secret_key
BETTER_AUTH_URL=http://localhost:8080
BETTER_AUTH_SAMESITE_NONE=false
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# ==============================
# CLOUD STORAGE (SUPABASE) - Lưu trữ ảnh bàn chân, video bài tập
# ==============================
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_BUCKET_NAME=your_bucket_name

# ==============================
# REDIS (TÙY CHỌN) - Dùng cho Queue/Cronjob (gửi thông báo nhắc lịch tập)
# ==============================
REDIS_URL=redis://localhost:36379
REDIS_HOST=localhost
REDIS_PORT=36379
REDIS_PASSWORD=your_redis_password_here